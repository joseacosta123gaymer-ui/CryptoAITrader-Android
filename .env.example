# Required: point this DNS name to the public IP of your Linux server.
APP_DOMAIN=trader.example.com

# Generate each secret independently; use at least 32 random characters.
APP_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_48_CHARS
FT_API_USERNAME=cryptoai
FT_API_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_24_CHARS
FT_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_48_CHARS
FT_WS_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_48_CHARS

# Public market data works without exchange keys in Dry-run mode.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
