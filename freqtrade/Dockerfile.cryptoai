# Crypto AI Trader image: based on the Freqtrade source supplied by the user.
# This keeps upstream source intact and adds the optional FreqAI dependencies.
FROM python:3.14.10-slim-trixie AS base

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PATH=/home/ftuser/.local/bin:$PATH \
    FT_APP_ENV="docker"

RUN mkdir /freqtrade \
    && apt-get update \
    && apt-get -y install --no-install-recommends sudo libatlas3-base curl sqlite3 libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -G sudo -U -m -s /bin/bash ftuser \
    && chown ftuser:ftuser /freqtrade \
    && echo "ftuser ALL=(ALL) NOPASSWD: /bin/chown" >> /etc/sudoers \
    && pip install --upgrade pip

FROM base AS python-deps
RUN apt-get update \
    && apt-get -y install --no-install-recommends build-essential libssl-dev git libffi-dev libgfortran5 pkg-config cmake gcc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --upgrade pip wheel

COPY --chown=ftuser:ftuser requirements.txt requirements-plot.txt requirements-freqai.txt /freqtrade/
USER ftuser
RUN pip install --user --no-cache-dir -r requirements-freqai.txt

FROM base AS runtime-image
COPY --from=python-deps --chown=ftuser:ftuser /home/ftuser/.local /home/ftuser/.local
USER ftuser
COPY --chown=ftuser:ftuser . /freqtrade/
RUN pip install -e . --user --no-cache-dir \
    && mkdir -p /freqtrade/user_data/strategies /freqtrade/user_data/logs \
    && freqtrade install-ui

ENTRYPOINT ["freqtrade"]
CMD ["trade"]
